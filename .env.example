# ==============================================================================
# RuralDR-XAI: Environment Configuration Template (SIH26038)
# Copy this file to .env and configure values before starting Docker services.
# ==============================================================================

# Database Connection (MySQL 8.x)
DATABASE_URL=mysql+pymysql://ruraldr_user:ruraldr_password_sih@mysql:3306/ruraldr_db
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ruraldr_db
MYSQL_USER=ruraldr_user
MYSQL_PASSWORD=ruraldr_password_sih
MYSQL_ROOT_PASSWORD=root_password_sih26038

# Authentication & Security
JWT_SECRET=ruraldr-xai-super-secret-production-key-sih26038
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# AWS S3 Storage (Private bucket for fundus photographs & diagnostic reports)
# Leave empty for automatic secure local storage fallback (data/uploads/)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=ruraldr-xai-retinal-scans

# Deep Learning Model & Dataset Paths
AI_MODEL_PATH=models/dr_classifier/best_model.pth
TRAINING_DATA_PATH=data/training

# Frontend API URL
FRONTEND_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# Professional Verification Provider Mode
# Set to true for automated test verification of standard professional credentials
AUTO_VERIFY_DEMO_REGISTRATIONS=true
