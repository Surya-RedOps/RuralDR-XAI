# Virtual environments
.venv/
env/
venv/

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Data and Raw images (strict compliance with No Large Data in Git)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Models / Checkpoints
models/checkpoints/*
!models/checkpoints/.gitkeep
models/classification/*
!models/classification/.gitkeep
models/image_quality/*
!models/image_quality/.gitkeep
models/segmentation/*
!models/segmentation/.gitkeep
models/localization/*
!models/localization/.gitkeep

# OS and IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# MATLAB cache
*.asv
*.slxc
slprj/

# Nested clones / backups
Base_Architecture/

# Temporary Uploads & Database
data/uploads/*
!data/uploads/.gitkeep
data/ruraldr.db

# Generated Screening Results
results/cli_demo/*
!results/cli_demo/.gitkeep
results/cli_screening/*
!results/cli_screening/.gitkeep
results/sample_screening/*
!results/sample_screening/.gitkeep
results/offline_queue/*
!results/offline_queue/.gitkeep

# Local Environment & Secrets
.env

