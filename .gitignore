# Virtual environments
.venv/
env/
venv/

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Data and Raw images (strict compliance with No Large Data in Git)
**/data/raw/*
!**/data/raw/.gitkeep
**/data/processed/*
!**/data/processed/.gitkeep
**/data/uploads/*
!**/data/uploads/.gitkeep

# Models / Checkpoints
**/models/checkpoints/*
!**/models/checkpoints/.gitkeep
**/models/classification/*
!**/models/classification/.gitkeep
**/models/image_quality/*
!**/models/image_quality/.gitkeep
**/models/segmentation/*
!**/models/segmentation/.gitkeep
**/models/localization/*
!**/models/localization/.gitkeep

# OS and IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# MATLAB cache
*.asv
*.slxc
slprj/

# Nested clones / backups
Base_Architecture/

# Environment and Secrets
.env
.env*.local

# Database files
*.db
*.sqlite
*.sqlite3

